# Inside the dev container these are already exported by docker-compose.yml.
# Copy to .env only when running the API outside the container.
DATABASE_URL=postgres://genealogy:genealogy@db:5432/genealogy
PORT=3000
# Comma-separated origins allowed to call the tRPC/auth endpoints.
# apps/frontend (:5173) is the only caller: its server-side proxy forwards
# the browser's real Origin header on every call it relays, so this is what
# better-auth's trustedOrigins check actually sees — the browser itself never
# calls this API directly except for unauthenticated <img> reads of
# /uploads/*, which aren't subject to CORS at all.
CORS_ORIGINS=http://localhost:5173

# Signs better-auth's session tokens. Any long random string; generate one with
# `openssl rand -base64 32`. Must stay stable across restarts, or existing
# sessions are invalidated.
BETTER_AUTH_SECRET=
# This server's own public URL — better-auth builds OAuth callback URLs from it.
BETTER_AUTH_URL=http://localhost:3000
# Create these in Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID, type "Web application"), with an authorized redirect URI of
# BETTER_AUTH_URL + /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where uploaded photos are written and served back from (at /uploads). A
# relative path resolves against the backend process's working directory —
# mount this as a volume in production so uploads survive a redeploy.
UPLOADS_DIR=./data/uploads
