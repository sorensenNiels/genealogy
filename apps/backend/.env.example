# Inside the dev container these are already exported by docker-compose.yml.
# Copy to .env only when running the API outside the container.
DATABASE_URL=postgres://genealogy:genealogy@db:5432/genealogy
# Backs the BullMQ queues (see "Long-running work: BullMQ + a shared Redis"
# in TECH_STACK.md) — the same Redis Immich uses, not a second instance.
REDIS_URL=redis://redis:6379
PORT=3000
# Comma-separated origins allowed to call the tRPC/auth endpoints.
# apps/frontend (:5173) is the only caller: its server-side proxy forwards
# the browser's real Origin header on every call it relays, so this is what
# better-auth's trustedOrigins check actually sees — the browser itself never
# calls this API directly except for unauthenticated <img> reads of
# /uploads/*, which aren't subject to CORS at all.
CORS_ORIGINS=http://localhost:5173

# Signs better-auth's session tokens. Any long random string; generate one with
# `openssl rand -base64 32`. Must stay stable across restarts, or existing
# sessions are invalidated.
BETTER_AUTH_SECRET=
# This server's own public URL — better-auth builds OAuth callback URLs from it.
BETTER_AUTH_URL=http://localhost:3000
# Create these in Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID, type "Web application"), with an authorized redirect URI of
# BETTER_AUTH_URL + /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where uploaded photos are written and served back from (at /uploads). A
# relative path resolves against the backend process's working directory —
# mount this as a volume in production so uploads survive a redeploy.
UPLOADS_DIR=./data/uploads

# Where a finished database dump is written before download — see the
# Tools page's "Backup database". Not served statically; deleted once
# downloaded.
BACKUPS_DIR=./data/backups
# Same lifecycle as BACKUPS_DIR, for a queued album/photo-library zip
# download (Photos' "Download all" and the Tools page's "Download all
# albums").
ALBUM_ZIPS_DIR=./data/album-zips
# Disk-streamed cap for a re-uploaded backup file on the Tools page's
# "Restore database" — much larger than IMMICH_MAX_UPLOAD_BYTES since a
# whole-database dump is bigger than a photo.
RESTORE_MAX_UPLOAD_BYTES=524288000

# Optional — the Photos feature (face-linked photos via Immich) stays hidden
# and the app runs fine with both left blank. Immich starts with the rest of
# the stack (`docker compose up -d`); generate a key by hand in
# its own web UI at http://localhost:2283 (Account Settings > API Keys) —
# there's no headless way to create one on first boot. Base server URL, no
# trailing /api — ImmichService appends the REST API's own base path itself.
# The key needs WRITE scopes, not just read — the full list is under
# "Photos & albums" in TECH_STACK.md (simplest: a key with all permissions).
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=
# Disk-streamed cap for photos uploaded through this app into Immich.
IMMICH_MAX_UPLOAD_BYTES=52428800

# Optional — mail sending (see MailService) stays in "log instead of send"
# mode with all three left blank, so the queue and its worker still run
# fine without a real mail provider configured. Point these at any SMTP
# relay (a real provider, or something like MailHog/Mailpit locally).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=genealogy@example.com
