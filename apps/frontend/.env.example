# Where this app's proxy layer (server functions + the /api/auth and
# /api/people/*/photo pass-through routes) reaches apps/backend. Never
# exposed to the browser — this app's own origin is the only one the
# browser ever talks to for everything except the one exception below.
BACKEND_URL=http://localhost:3000

# Client-visible counterpart, `VITE_`-prefixed so Vite inlines it into the
# browser bundle. Used only for uploaded-photo <img> reads (/uploads/*,
# unauthenticated static files, which aren't subject to CORS either way) —
# see "The proxy architecture" in CLAUDE.md for why this one path is a
# deliberate exception to routing everything through this app's own origin.
VITE_BACKEND_URL=http://localhost:3000
