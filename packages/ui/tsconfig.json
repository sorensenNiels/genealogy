{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",

    // Consumed as source by Vite rather than compiled here, so no emit and
    // bundler resolution to match how Vite will actually resolve the imports.
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  // vitest.setup.ts lives outside src/ (matching vitest.config.ts's own
  // location) but must still be type-checked: its jest-dom import is what
  // makes matchers like `toBeVisible` typecheck in every *.test.tsx file.
  "include": ["src/**/*", "vitest.setup.ts"],
  "exclude": ["node_modules"]
}
