{
  "name": "@genealogy/ui",
  "version": "0.0.0",
  "private": true,
  "description": "shadcn/ui component layer and the shared Tailwind theme.",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/read-only": "./src/lib/read-only.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@mdxeditor/editor": "catalog:",
    "@tanstack/react-form": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-aria-components": "catalog:",
    "react-easy-crop": "catalog:",
    "react-markdown": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@react-aria/test-utils": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
