{
  "name": "genealogy",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "bash scripts/kill-dev-ports.sh",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @genealogy/db db:generate",
    "db:migrate": "pnpm --filter @genealogy/db db:migrate",
    "db:studio": "pnpm --filter @genealogy/db db:studio"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1"
}
