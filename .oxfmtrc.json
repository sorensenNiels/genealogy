{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "objectWrap": "preserve",
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "apps/frontend/src/styles.css"
  },
  "ignorePatterns": ["**/routeTree.gen.ts", "**/drizzle/**", "pnpm-lock.yaml"]
}
